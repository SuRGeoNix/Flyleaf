<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>Detect and convert subtitle text encodings to UTF-8 for playback in FlyleafLib.</Description>
    <PackageTags>flyleaf flyleaflib plugin media subtitles charset encoding utf8 converter</PackageTags>
    <PackageReleaseNotes>first nuget release</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' == 'true'">
    <ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj">
      <Private>false</Private>
      <ExcludeAssets>All</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' != 'true'">
    <PackageReference Include="FlyleafLib" Version="[3.11.17,4.0.0)" />
  </ItemGroup>
</Project>
