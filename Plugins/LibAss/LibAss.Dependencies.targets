<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\tools\native\win-x64\**\*"
             Link="Plugins\LibAss\native\win-x64\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>
</Project>
