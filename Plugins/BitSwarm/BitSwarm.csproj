<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.0</Version>
    <Description>Play media directly from torrents with FlyleafLib using BitSwarm, without waiting for the entire download to complete</Description>
    <PackageTags>flyleaf flyleaflib plugin media torrent bittorrent bitswarm streaming</PackageTags>
    <PackageReleaseNotes>first nuget release</PackageReleaseNotes>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' == 'true'">
    <ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj">
      <Private>false</Private>
      <ExcludeAssets>All</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' != 'true'">
    <PackageReference Include="FlyleafLib" Version="[3.11.17,4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BitSwarm" Version="2.4.12" />
  </ItemGroup>
</Project>
