<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.0</Version>
    <Description>Search for and download subtitles with FlyleafLib from OpenSubtitles.org</Description>
    <PackageTags>flyleaf flyleaflib plugin media subtitles opensubtitles search download</PackageTags>
    <PackageReleaseNotes>first nuget release</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' == 'true'">
    <ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj">
      <Private>false</Private>
      <ExcludeAssets>All</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFlyleaf)' != 'true'">
    <PackageReference Include="FlyleafLib" Version="[3.11.17,4.0.0)" />
  </ItemGroup>
</Project>
