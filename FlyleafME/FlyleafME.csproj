<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Flyleaf.Controls.WPF</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>FlyleafME</PackageId>
    <FlyleafLibPackageVersionRange>[3.12.3,4.0.0)</FlyleafLibPackageVersionRange>
    <Version>2.0.0-preview.4</Version>
    <Authors>SuRGeoNix</Authors>
    <Copyright>SuRGeoNix © 2026</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SuRGeoNix/Flyleaf</PackageProjectUrl>
    <PackageIcon>Flyleaf.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>flyleaf flyleaflib flyleafme video audio wpf media player element control</PackageTags>
    <Description>A customizable WPF media player control powered by FlyleafLib, with built-in playback controls, a media queue, and dockable panels.</Description>
	<PackageReleaseNotes>
		- PlaybackBar: Adds Modern playback bar design with Compact, Full and Dynamic modes alongside Classic
		- PlaybackBar: Adds floating and docked layouts for both designs
		- PlaybackBar: Adds contextual expansion, persistent pin state and configurable Ctrl+B keybinding for Dynamic mode
		- PlaybackBar: Introduces a flat seek bar, accent-gradient volume controls and improved duration contrast
		- PlaybackBar: Keeps volume and mute controls available before opening media and during video-only playback
		- DebugOverlay: Introduces a translucent overlay with Playback, Video and Audio tabs, displaying detailed input/output information and playback statistics
		- DebugOverlay: Adds Tab to toggle visibility and Ctrl+Tab / Ctrl+Shift+Tab to navigate between tabs
		- MediaInformation: Improves runtime information updates using library notifications instead of periodic polling
		- Statistics: Shares statistics collection between the Debug Overlay and Media Information panel with automatic lifecycle management
		- Presentation: Adds custom accent colors and consistent accent presets across Light and Dark themes
		- Settings: Adds color pickers for subtitle text, subtitle outlines and video background
		- VideoFilters: Fixes resetting shared filter preferences across video processors
		- OSD: Renders messages behind overlay panels
	</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FlyleafLib" />
    <Using Include="FlyleafLib.Controls.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
    <None Include="..\Images\Flyleaf.png" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
