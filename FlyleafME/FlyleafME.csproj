<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Flyleaf.Controls.WPF</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>FlyleafME</PackageId>
    <FlyleafLibPackageVersionRange>[3.12.4,4.0.0)</FlyleafLibPackageVersionRange>
    <Version>2.0.0-preview.5</Version>
    <Authors>SuRGeoNix</Authors>
    <Copyright>SuRGeoNix © 2026</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SuRGeoNix/Flyleaf</PackageProjectUrl>
    <PackageIcon>Flyleaf.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>flyleaf flyleaflib flyleafme video audio wpf media player element control</PackageTags>
    <Description>A customizable WPF media player control powered by FlyleafLib, with built-in playback controls, a media queue, and dockable panels.</Description>
	<PackageReleaseNotes>
		- Lift subtitles just above the playback bar when it overlaps them, respecting the configured viewport and bottom offset
		- Add fullscreen auto-hide for unpinned left and right docked panels, with edge-hover reveal that keeps the video size fixed
		- Show video thumbnails alongside the seekbar’s hover time and chapter
		- Reuse resolved playlist item streams and prefer lower-resolution renditions when available
		- Cache thumbnails and keep the preview decoder open for 60 seconds of inactivity
		- Add Small, Medium, Large, and Custom percentage sizes that preserve the video’s aspect ratio
		- Enable seekbar previews for File, UNC, Web, and Live by default
		- Require a seek window longer than 45 seconds for live HLS thumbnails
	</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FlyleafLib" />
    <Using Include="FlyleafLib.Controls.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
    <None Include="..\Images\Flyleaf.png" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
