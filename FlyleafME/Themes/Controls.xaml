                                    <Ellipse Width="2.5" Height="2.5" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Ellipse Width="2.5" Height="2.5" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Ellipse Width="2.5" Height="2.5" VerticalAlignment="Bottom" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="PART_Fullscreen" Content="&#xE740;" AutomationProperties.Name="Fullscreen / normal" Style="{StaticResource FlyleafME.PlaybackIconButtonStyle}"
                                    Command="{Binding Player.Commands.ToggleFullScreen, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </StackPanel>
                        <Popup x:Name="PART_VolumePopup" Grid.Row="1" Grid.Column="2" Placement="Top" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Padding="8,10" CornerRadius="7" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource FlyleafME.OverlayBrush}" BorderBrush="{DynamicResource FlyleafME.OverlayBorderBrush}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Volume" FontSize="10" Margin="0,0,0,6" Foreground="{DynamicResource FlyleafME.OverlaySecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <me:FlyleafVolumeWedge Orientation="Vertical" Width="28" Height="110" Focusable="False" Cursor="Hand" AutomationProperties.Name="Volume"
                                            Minimum="0" Maximum="{Binding Player.Config.Audio.VolumeMax}"
                                            Value="{Binding Player.Audio.Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasAudio}">
                                        <me:FlyleafVolumeWedge.Template><ControlTemplate TargetType="me:FlyleafVolumeWedge"><Border Background="Transparent"/></ControlTemplate></me:FlyleafVolumeWedge.Template>
                                    </me:FlyleafVolumeWedge>
                                    <Button Content="{Binding VolumeIcon}" AutomationProperties.Name="Mute / Unmute" Margin="0,6,0,0" Command="{Binding Player.Commands.ToggleMute}" Style="{StaticResource FlyleafME.PlaybackIconButtonStyle}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                </Grid>
            </Border>
            <Grid x:Name="PART_DynamicHandleBand" Height="8" VerticalAlignment="Bottom" Background="Transparent" Visibility="Collapsed">
                <Button x:Name="PART_DynamicHandle" Width="46" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Opacity="0" Focusable="True" FocusVisualStyle="{x:Null}"
                        KeyboardNavigation.AcceptsReturn="True" Cursor="Hand"
                        Background="{DynamicResource FlyleafME.PlaybackTrackBrush}" Foreground="{DynamicResource FlyleafME.OverlayTextBrush}"
                        AutomationProperties.Name="Pin full playback bar">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FlyleafME.BorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0">
                            <Path Data="M 0,3 L 5,0 L 10,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource FlyleafME.RaisedSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource FlyleafME.AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger SourceName="PART_DynamicHandleBand" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_DynamicHandle" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsNonClientPointerOverDynamicHandleBand" Value="True">
                <Setter TargetName="PART_DynamicHandle" Property="Opacity" Value="1"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition SourceName="PART_DynamicHandle" Property="IsMouseOver" Value="True"/>
                    <Condition SourceName="PART_DynamicHandle" Property="IsKeyboardFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_DynamicHandle" Property="Focusable" Value="False"/>
            </MultiTrigger>
            <Trigger SourceName="PART_DynamicHandle" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PART_DynamicHandle" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsModernFullLayout" Value="True">
                <Setter TargetName="PART_CompactTimeline" Property="Grid.Row" Value="0"/>
                <Setter TargetName="PART_CompactTimeline" Property="Grid.Column" Value="0"/>
                <Setter TargetName="PART_CompactTimeline" Property="Grid.ColumnSpan" Value="3"/>
                <Setter TargetName="PART_CompactTimeline" Property="Height" Value="32"/>
                <Setter TargetName="PART_SourceGroup" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_TransportGroup" Property="Margin" Value="0,0,8,0"/>
                <Setter TargetName="PART_UtilityGroup" Property="Margin" Value="8,0,0,0"/>
                <Setter TargetName="PART_Settings" Property="Grid.Column" Value="1"/>
                <Setter TargetName="PART_Playlist" Property="Grid.Column" Value="0"/>
            </Trigger>
            <Trigger Property="IsDynamicMode" Value="True">
                <Setter TargetName="PART_DynamicHandleBand" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_CompactTimeline" Property="Grid.Row" Value="0"/>
                <Setter TargetName="PART_CompactTimeline" Property="Grid.Column" Value="0"/>
                <Setter TargetName="PART_CompactTimeline" Property="Grid.ColumnSpan" Value="3"/>
                <Setter TargetName="PART_CompactTimeline" Property="Height" Value="36"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDynamicMode" Value="True"/>
                    <Condition Property="IsModernFullLayout" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ModernActionsRow" Property="RowDefinition.Height" Value="0"/>
                <Setter TargetName="PART_TransportGroup" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_UtilityGroup" Property="Visibility" Value="Collapsed"/>
            </MultiTrigger>
            <DataTrigger Binding="{Binding Options.Floating, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter TargetName="PART_ModernFrame" Property="Margin" Value="8,0,8,10"/>
                <Setter TargetName="PART_Surface" Property="BorderThickness" Value="1"/>
                <Setter TargetName="PART_Surface" Property="CornerRadius" Value="7"/>
            </DataTrigger>
            <Trigger Property="DynamicPinned" Value="True">
                <Setter TargetName="PART_DynamicHandle" Property="Foreground" Value="{DynamicResource FlyleafME.AccentBrush}"/>
                <Setter TargetName="PART_DynamicHandle" Property="AutomationProperties.Name" Value="Unpin full playback bar"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="me:FlyleafPlaybackBar">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource FlyleafME.PlaybackBarClassicTemplate}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Options.Design, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafPlaybackBarDesign.Modern}">
                <Setter Property="Template" Value="{StaticResource FlyleafME.PlaybackBarModernTemplate}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Design, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafPlaybackBarDesign.Modern}"/>
                    <Condition Binding="{Binding Options.Mode, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafPlaybackBarMode.Full}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsModernFullLayout" Value="True"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding DynamicExpanded, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="IsModernFullLayout" Value="True"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Design, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafPlaybackBarDesign.Modern}"/>
                    <Condition Binding="{Binding Options.Mode, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafPlaybackBarMode.Dynamic}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsDynamicMode" Value="True"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Options.Visibility, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafVisibilityPolicy.Never}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Visibility, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafVisibilityPolicy.Auto}"/>
                    <Condition Binding="{Binding Player.CanPlay, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Visibility, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafVisibilityPolicy.Auto}"/>
                    <Condition Binding="{Binding Player.Status, RelativeSource={RelativeSource Self}}" Value="{x:Static player:Status.Opening}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
            <!-- Mouse activity takes precedence while media is playable or opening. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Visibility, RelativeSource={RelativeSource Self}}" Value="{x:Static me:FlyleafVisibilityPolicy.Auto}"/>
                    <Condition Binding="{Binding Player.Activity.Mode, RelativeSource={RelativeSource Self}}" Value="{x:Static player:ActivityMode.FullActive}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>