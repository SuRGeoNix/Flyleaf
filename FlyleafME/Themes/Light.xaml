<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="FlyleafME.BackgroundBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="FlyleafME.SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlyleafME.BorderBrush" Color="#D7DDE6"/>
    <SolidColorBrush x:Key="FlyleafME.TextBrush" Color="#202630"/>
    <SolidColorBrush x:Key="FlyleafME.SecondaryTextBrush" Color="#627080"/>
    <SolidColorBrush x:Key="FlyleafME.AccentBrush" Color="#B22222"/>

    <SolidColorBrush x:Key="FlyleafME.RaisedSurfaceBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="FlyleafME.HoverBrush" Color="#E4E9F1"/>
    <SolidColorBrush x:Key="FlyleafME.AccentHoverBrush" Color="#8E1B1B"/>
    <SolidColorBrush x:Key="FlyleafME.OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlyleafME.SelectionBrush" Color="#EFD2D2"/>
    <SolidColorBrush x:Key="FlyleafME.ErrorBrush" Color="#AF2424"/>
    <SolidColorBrush x:Key="FlyleafME.LogoMarkBrush" Color="#B22222"/>
    <SolidColorBrush x:Key="FlyleafME.LogoFoldBrush" Color="#791717"/>
    <SolidColorBrush x:Key="FlyleafME.LogoPlayBrush" Color="#202630"/>
    <SolidColorBrush x:Key="FlyleafME.LogoOutlineBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="FlyleafME.VideoBackgroundBrush" Color="#080A0D"/>

    <SolidColorBrush x:Key="FlyleafME.PlaybackTrackBrush" Color="#CBD4DF"/>
    <SolidColorBrush x:Key="FlyleafME.PlaybackBufferedBrush" Color="#929FAF"/>

    <LinearGradientBrush x:Key="FlyleafME.PlaybackVolumeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B22222" Offset="0"/>
        <GradientStop Color="#8E1B1B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Overlay contrast is defined separately from normal application surfaces. -->
    <SolidColorBrush x:Key="FlyleafME.OverlayBrush" Color="#EDF5F8FC"/>
    <SolidColorBrush x:Key="FlyleafME.OverlayBorderBrush" Color="#B1C5D2E2"/>
    <SolidColorBrush x:Key="FlyleafME.OverlayHoverBrush" Color="#5585A5CE"/>
    <SolidColorBrush x:Key="FlyleafME.OverlayPressedBrush" Color="#8594B4DC"/>
    <SolidColorBrush x:Key="FlyleafME.OverlayTextBrush" Color="#1A2638"/>
    <SolidColorBrush x:Key="FlyleafME.OverlaySecondaryTextBrush" Color="#46576C"/>

</ResourceDictionary>
