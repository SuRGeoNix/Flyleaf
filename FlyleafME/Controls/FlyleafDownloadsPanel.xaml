<UserControl x:Class="Flyleaf.Controls.WPF.FlyleafDownloadsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DownloadButton" TargetType="Button" BasedOn="{StaticResource FlyleafME.ButtonStyle}">
            <Setter Property="Width" Value="30"/><Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="DownloadRow" TargetType="ListBoxItem" BasedOn="{StaticResource FlyleafME.SuggestionItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FlyleafME.HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FlyleafME.SelectionBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FlyleafME.AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DownloadProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource FlyleafME.AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FlyleafME.BorderBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2.5"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsIndeterminate" Value="True">
                        <Trigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Pulse"/></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4">
            <Button x:Name="AddButton" Content="&#xE710;" ToolTip="Add download…" Click="Add_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="StartAllButton" Content="&#xE768;" ToolTip="Start all" Click="StartAll_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="PauseAllButton" Content="&#xE769;" ToolTip="Pause all" Click="PauseAll_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="StopAllButton" Content="&#xE71A;" ToolTip="Stop all" Click="StopAll_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="ClearButton" Content="&#xE894;" ToolTip="Clear finished" Click="Clear_Click" Style="{StaticResource DownloadButton}"/>
        </WrapPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="Concurrent downloads" VerticalAlignment="Center" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" Margin="0,0,8,0"/>
            <ComboBox x:Name="ConcurrencyBox" Width="62" SelectionChanged="Concurrency_Changed" Style="{DynamicResource FlyleafME.ComboBoxStyle}"/>
        </StackPanel>
        <ListBox x:Name="DownloadList" Grid.Row="2" ItemsSource="{Binding Jobs}" SelectionChanged="Selection_Changed"
                 Background="Transparent" Foreground="{DynamicResource FlyleafME.TextBrush}" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource DownloadRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,6" ToolTip="{Binding OutputPath}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Input}" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,7,0,4" Style="{StaticResource DownloadProgress}"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0" ToolTip="Selected download">
            <Button x:Name="StartButton" Content="&#xE768;" ToolTip="Start / Resume" Click="Start_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="PauseButton" Content="&#xE769;" ToolTip="Pause" Click="Pause_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="StopButton" Content="&#xE71A;" ToolTip="Stop" Click="Stop_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="OpenButton" Content="&#xE8A7;" ToolTip="Play file" Click="Open_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="FolderButton" Content="&#xE838;" ToolTip="Open folder" Click="Folder_Click" Style="{StaticResource DownloadButton}"/>
            <Button x:Name="RemoveButton" Content="&#xE74D;" ToolTip="Remove" Click="Remove_Click" Style="{StaticResource DownloadButton}"/>
        </WrapPanel>
        <TextBlock Grid.Row="4" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
