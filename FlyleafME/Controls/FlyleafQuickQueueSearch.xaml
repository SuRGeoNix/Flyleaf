<UserControl x:Class="Flyleaf.Controls.WPF.FlyleafQuickQueueSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" PreviewKeyDown="Search_KeyDown">
    <Border Background="{DynamicResource FlyleafME.SurfaceBrush}" BorderBrush="{DynamicResource FlyleafME.BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{DynamicResource FlyleafME.InputStyle}" Padding="30,7,8,7"
                             FontSize="15" VerticalContentAlignment="Center" AutomationProperties.Name="Search queue"
                             TextChanged="Search_TextChanged"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="10,0,0,0"
                               Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" HorizontalAlignment="Left"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Search queue…" FontSize="15" Margin="30,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="Close (Esc)" AutomationProperties.Name="Close quick search"
                        Style="{DynamicResource FlyleafME.ButtonStyle}" MinWidth="34" Padding="6" Margin="6,0,0,0" Focusable="False" Click="Close_Click"/>
            </Grid>
            <TextBlock x:Name="ResultCount" Grid.Row="1" Margin="2,9,2,4" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" FontSize="12"/>
            <Grid Grid.Row="2">
                <ListBox x:Name="Results" Background="Transparent" Foreground="{DynamicResource FlyleafME.TextBrush}" BorderThickness="0"
                         ItemContainerStyle="{DynamicResource FlyleafME.SuggestionItemStyle}" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" IsTabStop="False" PreviewMouseLeftButtonUp="Results_MouseUp">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IndexText}" Margin="0,0,10,0" TextAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FlyleafME.AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoResults" Text="No matching items" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Grid.Row="3" Margin="2,8,2,0" FontSize="11" Foreground="{DynamicResource FlyleafME.SecondaryTextBrush}"
                       Text="↑ ↓ Navigate    ·    Enter Play    ·    Esc Close" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
