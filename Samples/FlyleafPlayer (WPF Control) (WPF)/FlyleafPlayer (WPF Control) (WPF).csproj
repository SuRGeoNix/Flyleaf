<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FlyleafPlayer</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>FlyleafPlayer</AssemblyName>
    <ApplicationIcon>Flyleaf.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Copyright>SuRGeoNix © 2026</Copyright>
    <Authors>SuRGeoNix</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FlyleafLib.Controls.WPF\FlyleafLib.Controls.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="Flyleaf_TitleBar_128.png" />
  </ItemGroup>

    <ItemGroup>
	    <Content Include="$(SolutionDir)FFmpeg\**\*">
		    <Link>FFmpeg\%(RecursiveDir)%(Filename)%(Extension)</Link>
		    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FlyleafLib.Plugins.BitSwarm" Version="1.3.0" />
      <PackageReference Include="FlyleafLib.Plugins.OpenSubtitlesOrg" Version="1.3.0" />
      <PackageReference Include="FlyleafLib.Plugins.SubtitlesConverter" Version="1.0.0" />
    </ItemGroup>

</Project>
