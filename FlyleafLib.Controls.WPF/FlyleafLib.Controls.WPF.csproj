<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
	<UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Version>1.8.0</Version>
    <FlyleafLibPackageVersionRange>[3.12.0,3.13.0)</FlyleafLibPackageVersionRange>
    <Authors>SuRGeoNix</Authors>
    <Copyright>SuRGeoNix © 2026</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SuRGeoNix/Flyleaf</PackageProjectUrl>
    <PackageIcon>Flyleaf.png</PackageIcon>
    <PackageIconUrl />
    <PackageTags>flyleaf flyleaflib flyleafme video audio wpf media player element control</PackageTags>
    <Description>Legacy WPF media element control powered by FlyleafLib. For new .NET 10 WPF projects, use the FlyleafME package.</Description>
    <PackageReleaseNotes>Compatible with FlyleafLib 3.12.x. FlyleafME is the successor package for .NET 10 WPF and uses a new control API. See https://github.com/SuRGeoNix/Flyleaf/tree/master/FlyleafME</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-windows|AnyCPU'">
    <WarningLevel>6</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-windows|AnyCPU'">
    <WarningLevel>6</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dragablz" Version="0.0.3.234" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.1-ci1521" />
    <PackageReference Include="WpfColorFontDialog" Version="1.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib\FlyleafLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Images\Flyleaf.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
