<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
	<UseWindowsForms>true</UseWindowsForms>
	<UseWPF>true</UseWPF>
	<PackageIcon>Flyleaf.png</PackageIcon>
	<PackageIconUrl />
	<RepositoryUrl></RepositoryUrl>
	<Description>Media Player .NET Library for WinUI 3/WPF/WinForms (based on FFmpeg/DirectX)</Description>
	<Version>3.11.14</Version>
	<Authors>SuRGeoNix</Authors>
	<Copyright>SuRGeoNix © 2026</Copyright>
	<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
	<PackageProjectUrl>https://github.com/SuRGeoNix/Flyleaf</PackageProjectUrl>
	<PackageTags>flyleaf flyleaflib video audio media player engine framework download extract ffmpeg vortice directx</PackageTags>
	<IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>
		- Renderer.HDR: Improve tone mapping with LMS cone-channel processing
		- Renderer.HDR: Replaces polynomial PQSpline with hyperbolic segments to prevent overshoot and highlight clipping
		- Renderer.HDR: Extends HDRDetect with maxRGB scene average for more accurate tone-mapping adaptation
		- Renderer.HDR.Dovi: Adds L2 (CM 2.9) trims support (slope, offset, power, saturation, chroma weight, MS weight)
		- Controls.WPF.PlayerDebug: Fixes an issue with Video Processor was not visible

		[Breaking Changes]
		- Config.Demuxer: Increases default timeouts for read, seek, and close operations
	</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DocumentationFile>FlyleafLib.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-windows|AnyCPU'">
    <WarningLevel>6</WarningLevel>
    <NoWarn>1701;1702;WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-windows|AnyCPU'">
    <WarningLevel>6</WarningLevel>
    <NoWarn>1701;1702;WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows|AnyCPU'">
    <NoWarn>1701;1702;WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows|AnyCPU'">
    <NoWarn>1701;1702;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Images\Flyleaf.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Flyleaf.FFmpeg.ABI" Version="9.0.0" />
	<PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
	<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
	<PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
	<PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
	<PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
	<PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
  </ItemGroup>

</Project>
